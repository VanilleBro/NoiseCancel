<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnToggle"
            android:layout_width="176dp"
            android:layout_height="176dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_toggle_off"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/btn_start"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/state_off"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <!-- Stärke -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/gain_title" />

                <TextView
                    android:id="@+id/tvGainValue"
                    style="@style/Value" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnGainMinus"
                    style="@style/StepButton"
                    android:text="−" />

                <SeekBar
                    android:id="@+id/sbGain"
                    style="@style/Slider" />

                <TextView
                    android:id="@+id/btnGainPlus"
                    style="@style/StepButton"
                    android:text="+" />
            </LinearLayout>

            <TextView
                style="@style/Hint"
                android:text="@string/gain_hint" />
        </LinearLayout>

        <!-- Phase -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/offset_title" />

                <TextView
                    android:id="@+id/tvOffsetValue"
                    style="@style/Value" />

                <TextView
                    android:id="@+id/btnOffsetZero"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_step"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/offset_zero"
                    android:textColor="@color/text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnOffsetMinus"
                    style="@style/StepButton"
                    android:text="−" />

                <SeekBar
                    android:id="@+id/sbOffset"
                    style="@style/Slider" />

                <TextView
                    android:id="@+id/btnOffsetPlus"
                    style="@style/StepButton"
                    android:text="+" />
            </LinearLayout>

            <TextView
                style="@style/Hint"
                android:text="@string/offset_hint" />
        </LinearLayout>

        <!-- Analyse -->
        <LinearLayout style="@style/Card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/analysis_title"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="@string/row_pred" />
                <TextView android:id="@+id/tvPred" style="@style/RowValue" android:text="@string/dash" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbPred"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginBottom="6dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/track"
                android:progressTint="@color/accent" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="@string/row_gate" />
                <TextView android:id="@+id/tvGate" style="@style/RowValue" android:text="@string/dash" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="@string/row_red" />
                <TextView android:id="@+id/tvRed" style="@style/RowValue" android:text="@string/dash" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="@string/row_input" />
                <TextView android:id="@+id/tvInput" style="@style/RowValue" android:text="@string/dash" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="@string/row_out" />
                <TextView android:id="@+id/tvOut" style="@style/RowValue" android:text="@string/dash" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="@string/row_latency" />
                <TextView android:id="@+id/tvLatency" style="@style/RowValue" android:text="@string/dash" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="@string/row_path" />
                <TextView android:id="@+id/tvPath" style="@style/RowValue" android:text="@string/dash" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/RowLabel" android:text="@string/row_events" />
                <TextView android:id="@+id/tvEvents" style="@style/RowValue" android:text="@string/dash" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnRelearn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_step"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/relearn"
                android:textColor="@color/text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Erklärung -->
        <LinearLayout style="@style/Card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/how_title"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Hint"
                android:text="@string/how_text" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
